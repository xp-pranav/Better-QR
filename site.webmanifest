{
  "name": "Better QR",
  "short_name": "Better QR",
  "description": "Make Every Scan Better. Free, open-source, local-first browser QR generator with neo-brutalist styling, 20+ export formats, print layout studio, and bulk generation. Works 100% offline.",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#F7F7F4",
  "theme_color": "#FFE600",
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "assets/icons/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
